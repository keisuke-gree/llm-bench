{
  "env": {
    "ANTHROPIC_AUTH_TOKEN": "ollama",
    "ANTHROPIC_BASE_URL": "http://localhost:11434",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "CLAUDE_CODE_DISABLE_OFFICIAL_MARKETPLACE_AUTOINSTALL": "1",
    "CLAUDE_CODE_MAX_CONTEXT_TOKENS": "262144",
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "230000"
  },
  "claudeMdExcludes": [
    "**/.claude/CLAUDE.md"
  ],
  "skillOverrides": {
    "benchmark-score": "off",
    "benchmark-report": "off",
    "benchmark-run": "off"
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "filesystem": {
      "denyRead": [
        "~/.ssh",
        "~/.gnupg",
        "~/llm-bench/answers",
        "~/llm-bench/tasks",
        "~/llm-bench/results",
        "~/llm-bench/reports",
        "~/llm-bench/docs",
        "~/llm-bench/bin"
      ],
      "denyWrite": [
        "~/.claude/settings.json",
        "~/.ssh",
        "~/.gnupg"
      ]
    }
  },
  "model": "gemma4:26b",
  "disableAllHooks": false,
  "disableClaudeAiConnectors": true,
  "permissions": {
    "allow": [
      "Read(**)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(composer install)",
      "Bash(composer show *)",
      "Bash(vendor/bin/phpcs *)",
      "Bash(vendor/bin/phpstan *)",
      "Bash(vendor/bin/phpunit *)",
      "Bash(docker-compose -f tools/ci/docker-compose.yml up *)",
      "Bash(docker-compose -f tools/ci/docker-compose.yml down)",
      "Bash(ollama ps)",
      "Bash(ollama run *)",
      "Bash(rg *)",
      "Bash(fd *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Grep",
      "Glob"
    ],
    "deny": [
      "mcp__*",
      "WebSearch",
      "WebFetch",
      "Bash(sudo *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(nc *)",
      "Bash(netcat *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(rsync *)",
      "Bash(ftp *)",
      "Bash(sftp *)",
      "Bash(claude --dangerously-skip-permissions*)",
      "Bash(rm *)",
      "Bash(git push * main*)",
      "Bash(git push * master*)",
      "Bash(git push * develop*)",
      "Bash(git push *--force*)",
      "Bash(git push *-f *)",
      "Bash(git push *-f)",
      "Read(.env*)",
      "Read(.ssh/*)",
      "Read(id_rsa)",
      "Read(id_ed25519)",
      "Read(id_ecdsa)",
      "Read(*.pem)",
      "Read(*.key)",
      "Read(*.p12)",
      "Read(*.pfx)",
      "Read(*.cert)",
      "Read(*.cer)",
      "Edit(.env*)"
    ]
  }
}
